<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>14.0</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Version>0.0.1</Version>
        <RootNamespace>MedicalSmartBox.API</RootNamespace>
        <AssemblyName>MedicalSmartBox.API</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <!-- Asp.Net Core related packages -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13"/>
        <PackageReference Include="Scalar.AspNetCore" Version="2.18.0"/>
        <!-- Entity Framework Core related packages -->
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <!-- MySQL Entity Framework Core provider -->
        <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9"/>
        <!-- Naming convention conversion related packages -->
        <PackageReference Include="Humanizer" Version="3.0.10"/>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Transport\Application\Commands\" />
      <Folder Include="Transport\Application\Interfaces\" />
      <Folder Include="Transport\Application\Queries\" />
      <Folder Include="Transport\Domain\Enums\" />
      <Folder Include="Transport\Infrastructure\ExternalServices\TrafficRouting\" />
      <Folder Include="Transport\Interfaces\Rest\Controllers\" />
      <Folder Include="Transport\Interfaces\Rest\Request\" />
      <Folder Include="Transport\Interfaces\Rest\Responses\" />
      <Folder Include="Transport\Resources\Errors\" />
      <Folder Include="Transport\Resources\Localization\" />
    </ItemGroup>

</Project>
